# DocMind API — Environment Variables
# Copy to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Master API key for admin endpoints (generate a strong one)
ADMIN_KEY=dm_admin_change_me

# LLM Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# Default provider: anthropic | openai | google
DEFAULT_PROVIDER=anthropic

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Usage tracking (optional — set to a webhook URL to receive usage events)
USAGE_WEBHOOK_URL=
